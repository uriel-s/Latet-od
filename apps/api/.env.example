# Copy to apps/api/.env for local runs. .env is git-ignored; never commit real values.
# Production values live in Vercel's Environment Variables (Production), never here: docs/deploy.md.
PORT=3000

# MongoDB Atlas connection string (ADR-0001). Required: the api refuses to start without it.
# The path names the database (required: "/bottlerun" below); without it the driver would
# silently use a database called "test". Use a DB user with access to this database only
# (ADR-0002). It holds the password: never commit the real value, never log it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bottlerun?retryWrites=true&w=majority

# Local only: the session cookie drops its Secure attribute, so login works over http://localhost.
# Never set it on the hosting: anything other than "development" (or nothing) keeps Secure on.
NODE_ENV=development

# The collector's password as a scrypt hash, "scrypt$<salt>$<hash>" (ADR-0004). Required: the api
# refuses to start without it, or with a malformed one. Never the password itself. Generate it:
#   npm run -s hash-password --workspace apps/api
# (asks twice, hidden). In Git Bash's own window, where it cannot ask, copy it to the clipboard:
#   read -rs PW; printf '%s' "$PW" | npm run -s hash-password --workspace apps/api | clip; unset PW
# Changing the password = a new hash here (and on the hosting) and a restart / redeploy.
COLLECTOR_PASSWORD_HASH=scrypt$<salt>$<hash>

# Key that signs the session cookie (ADR-0004). Required, at least 32 characters. Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Replacing it logs out every device (e.g. if Yoel's phone is lost). Use a different one per env.
SESSION_SECRET=<paste the generated secret>

# The site's public origin: every link inside a WhatsApp message is <this>/o/<token> (ADR-0003).
# Required: the api refuses to start without it. Scheme, host and port only: no path, query or #.
# Local: the Vite dev server, http://localhost:5173 (the customer page lives on the web app, and
# Vite proxies /api to this api). Production: the https Vercel or custom domain.
PUBLIC_BASE_URL=http://localhost:5173

# Which WhatsApp sender the api uses (ADR-0003). Optional; unset means wame.
#   wame   Yoel taps "send" on a prepared wa.me link, from his own number. Free; the MVP.
#   cloud  reserved for the official WhatsApp Cloud API; not built yet (the api refuses to start).
MESSAGE_SENDER=wame

# Where every route starts: Yoel's home (ADR-0005). "lat,lng" in decimal degrees, latitude first.
# Required: the api refuses to start without it, with a malformed one, or with a point more than
# 30 km from the drop-off (that usually means latitude and longitude are swapped).
# Private: it lives only here and in the hosting env, never in code, docs or commits.
# To get it: right-click the house on openstreetmap.org → "Show address" (the coordinates appear
# on the left), or long-press it in Google Maps (the coordinates appear in the search box).
ROUTE_START=<lat>,<lng>

# Web Push (VAPID) for notifying Yoel when a new order arrives from the public form (ADR-0013).
# Optional: when all three are unset, the api runs normally with Web Push disabled
# (GET /api/collector/push/config answers { enabled: false }). If any one is set, all three must
# be set and valid. Generate a key pair once with Node's built-in crypto:
#   node -e "const c=require('node:crypto').createECDH('prime256v1');c.generateKeys();console.log('VAPID_PUBLIC_KEY='+c.getPublicKey('base64url'));console.log('VAPID_PRIVATE_KEY='+c.getPrivateKey('base64url'))"
# VAPID_SUBJECT is a contact URI for the push service: "mailto:<email>" or "https://<domain>".
# VAPID_PUBLIC_KEY=<65-byte uncompressed P-256 public key in base64url>
# VAPID_PRIVATE_KEY=<32-byte P-256 private key in base64url>
# VAPID_SUBJECT=mailto:example@gmail.com
