# Copy to apps/api/.env for local runs. .env is git-ignored; never commit real values.
PORT=3000

# MongoDB Atlas connection string (ADR-0001). Required: the api refuses to start without it.
# The path names the database (required: "/bottlerun" below); without it the driver would
# silently use a database called "test". Use a DB user with access to this database only
# (ADR-0002). It holds the password: never commit the real value, never log it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bottlerun?retryWrites=true&w=majority

# Local only: the session cookie drops its Secure attribute, so login works over http://localhost.
# Never set it on the hosting: anything other than "development" (or nothing) keeps Secure on.
NODE_ENV=development

# The collector's password as a scrypt hash, "scrypt$<salt>$<hash>" (ADR-0004). Required: the api
# refuses to start without it, or with a malformed one. Never the password itself. Generate it:
#   npm run -s hash-password --workspace apps/api
# (asks twice, hidden). In Git Bash's own window, where it cannot ask, copy it to the clipboard:
#   read -rs PW; printf '%s' "$PW" | npm run -s hash-password --workspace apps/api | clip; unset PW
# Changing the password = a new hash here (and on the hosting) and a restart / redeploy.
COLLECTOR_PASSWORD_HASH=scrypt$<salt>$<hash>

# Key that signs the session cookie (ADR-0004). Required, at least 32 characters. Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Replacing it logs out every device (e.g. if Yoel's phone is lost). Use a different one per env.
SESSION_SECRET=<paste the generated secret>

# Added by later P4 sections (see docs/decisions/):
# ROUTE_START=lat,lng          ADR-0005 (Yoel's home: private, never in code)
# MESSAGE_SENDER=wame          ADR-0003
